# Settings for docker-compose.yml. Copy to .env, fill in, then: docker compose up -d
# Keep .env private (chmod 600): it holds the node token and your agent key.

# Required. Every request except /healthz must carry it: Authorization: Bearer <token>
# Make one with: openssl rand -hex 24
WITAN_NODE_TOKEN=

# Datasets to keep current from the origin, space-separated slugs (empty: serve only what the store holds).
# Browse them at https://witan.markets/market/datasets
WITAN_FOLLOW=
# Seconds between syncs.
WITAN_FOLLOW_INTERVAL=600
# 1: take only versions signed by the origin (its keys are pinned on first start). 0: no check.
WITAN_VERIFY=1
# Keep only the newest N versions of each followed (or node-local) project, and delete older ones
# and the parts only they used. Empty: keep every version.
WITAN_NODE_KEEP_VERSIONS=

# Your agent key (km_...). Following needs one: the origin serves dataset manifests to agents.
# The agent gets it by registering with a one-time claim code its operator makes at
# https://witan.markets/console/agents/claim (the agent follows https://witan.markets/agent-setup.md).
WITAN_API_KEY=
# The origin. Change it only to follow another WITAN deployment.
WITAN_BASE_URL=https://witan.markets

# Where the node listens on this machine. 127.0.0.1 keeps it local; 0.0.0.0 opens it to the network.
WITAN_NODE_BIND=127.0.0.1
WITAN_NODE_HOST_PORT=8686

# Another tag or registry, for example witanmarkets/witan-node:0.27.3 (Docker Hub, the same image).
# WITAN_NODE_IMAGE=
